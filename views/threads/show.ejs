<% layout('layouts/boilerplate') %>
<div class="card shadow-sm mb-4">
  <div class="card-body">
    <h3 class="fw-bold mb-3"><%= thread.title %></h3>
    <p class="text-body-secondary mb-0">
        <%= thread.content %>
    </p>
        <%
            const FIVE_MINUTES = 5 * 60 * 1000;
            const isWithinTime = (Date.now() - thread.createdAt.getTime()) < FIVE_MINUTES;
        %>
    
        <% if (currentUser && thread.author.equals(currentUser._id) && isWithinTime) { %>
                <form action="/threads/<%= thread._id %>/edit" method="GET" class="d-inline">
                    <button type="submit" class="delete-btn btn btn-success mt-3" data-id="<%= thread._id %>">編集する</button>
                </form>
        <% } %>
  </div>
</div>

<% posts.forEach((post, index) => { 
    let bgClass = 'bg-body-tertiary';
    if (currentUser && post.author._id.equals(currentUser._id)) {
        bgClass = 'bg-info-subtle';
    } else if (post.author._id.equals(thread.author._id)) {
        bgClass = 'bg-warning-subtle';
    }
%>
    <div class="mb-3 p-3 rounded-3 <%= bgClass %>">
        <div class="d-flex align-items-center">
            <div class="d-flex align-items-center">
                <p class="mb-0">[<%= index + 1 %>] <%= post.author.username %></p>
            </div>
            <small class="text-muted ms-2"><%= post.createdAt.toLocaleString() %> <% if(post.edited) { %> (編集済み) <% } %></small>
        </div>
        <%= post.content %>
        <% if (currentUser && post.author.equals(currentUser._id)) { %>
            <button type="button" class="edit-btn btn btn-success ms-3" data-id="<%= post._id %>" data-content="<%= post.content %>">編集する</button>
        <% } %>
        <% if (currentUser && post.author.equals(currentUser._id)) { %>
            <button type="submit" class="delete-btn btn btn-danger ms-3 delete-trigger" data-bs-toggle="modal" data-bs-target="#staticBackdrop" data-id="<%= post._id %>">削除する</button>
        <% } %>
    </div>
<% }) %>

<% if (currentUser) { %>
    <div id="editNotice" class="alert alert-warning d-none">
        現在この投稿を編集中です
        <button type="button" class="btn btn-sm btn-outline-dark ms-3" id="cancelEdit">
            キャンセル
        </button>
    </div>
    <form id="postForm" action="/threads/<%= thread._id %>/posts" method="POST" class="needs-validation" novalidate>
        <div class="mb-3">
            <label for="replyInput" class="form-label">返信を入力</label>
            <textarea name="content" class="form-control" id="replyInput" rows="3" placeholder="返信を入力..." required></textarea>
            <div class="valid-feedback">
                OK!
            </div>
            <div class="invalid-feedback">
                内容を入力してください
            </div>
        </div>

        <div class="d-flex justify-content-between mt-3">
            <a href="/threads" class="btn btn-danger">
                スレッド一覧に戻る
            </a>
            <button id="submitBtn" class="btn btn-primary px-4">
                投稿する
            </button>
        </div>
    </form>
<% } else { %>
    <div class="alert alert-info text-center" role="alert">
        返信するには<a href="/login" class="alert-link">ログイン</a>してください。
    </div>
<% } %>

<%- include('../partials/deleteModal') %>

<script>
    const editButtons = document.querySelectorAll('.edit-btn');
    const textarea = document.getElementById('replyInput');
    const form = document.getElementById('postForm');
    
    const submitBtn = document.getElementById('submitBtn');
    const editNotice = document.getElementById('editNotice');
    const cancelEdit = document.getElementById('cancelEdit');

    let originalAction = form.action;
    let editingPostElement = null;

    editButtons.forEach(button => {
        button.addEventListener('click', () => {
            const postId = button.dataset.id;
            const content = button.dataset.content;

            textarea.value = content;
            
            form.action = `/posts/${postId}?_method=PUT`;
            form.classList.add("border", "border-warning", "bg-warning-subtle");
            editNotice.classList.remove("d-none");
            submitBtn.textContent = "更新する";
            submitBtn.classList.remove("btn-primary");
            submitBtn.classList.add("btn-warning");
            if (editingPostElement) {
                editingPostElement.classList.remove("border", "border-danger");
            }
            editingPostElement = button.closest('.bg-body-tertiary');
            editingPostElement.classList.add("border", "border-danger");

            textarea.scrollIntoView({ behavior: 'smooth' });
        });

        cancelEdit.addEventListener('click', () => {
            textarea.value = "";
            
            form.action = originalAction;

            form.classList.remove("border", "border-warning", "bg-warning-subtle");

            editNotice.classList.add("d-none");

            submitBtn.textContent = "投稿する";
            submitBtn.classList.remove("btn-warning");
            submitBtn.classList.add("btn-primary");

            if (editingPostElement) {
                editingPostElement.classList.remove("border", "border-danger");
                editingPostElement = null;
            }
        });
    });

    const deleteButtons = document.querySelectorAll('.delete-trigger');
    const deleteForm = document.getElementById('deleteForm');

    deleteButtons.forEach(button => {
        button.addEventListener('click', () => {
            const postId = button.dataset.id;
            deleteForm.action = `/posts/${postId}?_method=DELETE`;
        });
    });
</script>


