<% layout('layouts/boilerplate') %>
<div class="card shadow-sm mb-4">
  <div class="card-body">
    <h3 class="fw-bold mb-3"><%= thread.title %></h3>
    <p class="text-body-secondary mb-0">
      <%= thread.content %>
    </p>
  </div>
</div>

<% for (let post of posts) { %>
    <div class="mb-3 p-3 bg-body-tertiary rounded-3">
        <%= post.content %>
    </div>
<% } %>

<form action="/threads/<%= thread._id %>/posts" method="POST">
    <div class="mb-3">
        <label for="replyInput" class="form-label">返信を入力</label>
        <textarea name="content" class="form-control" id="replyInput" rows="3" placeholder="返信を入力..." required></textarea>
    </div>

    <div class="d-flex justify-content-between mt-3">
        <a href="/threads" class="btn btn-danger">
            スレッド一覧に戻る
        </a>
        <button class="btn btn-primary px-4">
            投稿する
        </button>
    </div>
</form>

