<% layout('layouts/boilerplate') %>
<h1>スレッド一覧</h1>
<a href="/threads/new">スレッド新規作成</a>

<% for (let thread of threads) { %>
    <div class="card mb-3">
        <h5 class="card-header">Featured</h5>
        <div class="card-body">
            <h5 class="card-title"><%= thread.title %></h5>
            <p class="card-text"><%= thread.content %></p>
            <a href="/threads/<%= thread._id %>" class="btn btn-primary">スレッドを見る</a>
            <% if (currentUser && thread.author.equals(currentUser._id)) { %>
                <form action="/threads/<%= thread._id %>?_method=DELETE" method="POST" class="d-inline">
                    <button type="submit" class="delete-btn btn btn-danger ms-3" data-id="<%= thread._id %>">削除する</button>
                </form>
            <% } %>
        </div>
    </div>
<% } %>


