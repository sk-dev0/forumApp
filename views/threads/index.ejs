<% layout('layouts/boilerplate') %>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-3">
    <h1>スレッド一覧</h1>
    <% if (currentUser) { %>
        <a href="/threads/new" class="btn btn-primary mb-3 btn-lg">スレッド新規作成</a>
    <% } else { %>
        <a href="/login" class="btn btn-primary mb-3 btn-lg">ログインしてスレッド新規作成</a>
    <% } %>
</div>

<div class="card mb-4">
    <div class="card-header">
        <strong>🔍 スレッドを絞り込む</strong>
    </div>
    <div class="card-body">
        <form action="/threads" method="GET" class="d-flex gap-2 mb-3 align-items-center">
            <% if (currentTag) { %>
                <input type="hidden" name="tag" value="<%= currentTag %>">
            <% } %>
            <input type="text" class="form-control form-control-sm" name="keyword" placeholder="タイトルで検索..." value="<%= currentKeyword || '' %>" style="max-width: 250px;">
            <button type="submit" class="btn btn-primary btn-sm px-4 text-nowrap">検索</button>
            <% if (currentKeyword) { %>
                <a href="/threads<%= currentTag ? '?tag=' + currentTag : '' %>" class="btn btn-outline-secondary btn-sm px-4 text-nowrap">クリア</a>
            <% } %>
        </form>

        <div class="d-flex flex-nowrap gap-2 mb-2 overflow-auto">
            <a href="/threads" class="btn btn-sm flex-shrink-0 <%= !currentTag ? 'btn-secondary' : 'btn-outline-secondary' %>">
                すべて
            </a>
            <% for (let category in tagCategories) { %>
                <button type="button" class="btn btn-sm btn-outline-primary category-btn flex-shrink-0" data-category="<%= category %>">
                    <%= category %>
                </button>
            <% } %>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <% for (let category in tagCategories) { %>
                <div class="tag-group d-none" data-group="<%= category %>">
                    <% for (let tag of tagCategories[category]) { %>
                        <a href="/threads?tag=<%= tag %>" class="btn btn-sm <%= currentTag === tag ? 'btn-secondary' : 'btn-outline-secondary' %>">
                            <%= tag %>
                        </a>
                    <% } %>
                </div>
            <% } %>
        </div>
    </div>
</div>


<% for (let thread of threads) { %>

    <% 
        const FIVE_MINUTES = 5 * 60 * 1000;
        const isWithinTime = (Date.now() - thread.createdAt.getTime()) < FIVE_MINUTES;
    %>

    <div class="card mb-3">
        <div class="card-header">
        <!-- PC: 1段横並び / スマホ: 2段 -->
            <div class="d-flex flex-column flex-md-row align-items-md-center">
                <!-- 左側: ユーザー名と投稿時間 -->
                <div class="d-flex align-items-center gap-2">
                    <h5 class="mb-0"><%= thread.author.username %></h5>
                    <small class="text-muted"><%= thread.createdAt.toLocaleString() %></small>
                </div>
                <!-- 右側: ポスト数とタグ -->
                <div class="d-flex align-items-center gap-2 ms-md-auto mt-1 mt-md-0">
                    <small class="fw-bold text-primary text-nowrap">💬 <%= thread.postCount %>件</small>
                    <% for (let tag of thread.tags) { %>
                        <a href="/threads?tag=<%= tag %>" class="badge bg-secondary text-decoration-none">
                            <%= tag %>
                        </a>
                    <% } %>
                </div>
            </div>
        </div> 
        <div class="card-body">
            <h5 class="card-title"><%= thread.title %></h5>
            <p class="card-text"><%= thread.content %></p>
            <a href="/threads/<%= thread._id %>" class="btn btn-primary">スレッドを見る</a>

            <% if (currentUser && thread.author.equals(currentUser._id) && isWithinTime) { %>
                <form action="/threads/<%= thread._id %>/edit" method="GET" class="d-inline">
                    <button type="submit" class="delete-btn btn btn-success ms-3" data-id="<%= thread._id %>">編集する</button>
                </form>
            <% } %>

            <% if (currentUser && thread.author.equals(currentUser._id)) { %>
                <button type="button" class="delete-btn btn btn-danger ms-3 delete-trigger" data-bs-toggle="modal" data-bs-target="#staticBackdrop" data-id="<%= thread._id %>" data-type="thread">削除する</button>
            <% } %>
        </div>
    </div>
<% } %>

<% if (totalPages > 1) { %>
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                <a class="page-link" href="/threads?page=<%= currentPage - 1 %><%= currentTag ? '&tag=' + currentTag : '' %><%= currentKeyword ? '&keyword=' + currentKeyword : '' %>">前へ</a>
            </li>

            <% for (let i = 1; i <= totalPages; i++) { %>
                <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                    <a class="page-link" href="/threads?page=<%= i %><%= currentTag ? '&tag=' + currentTag : '' %><%= currentKeyword ? '&keyword=' + currentKeyword : '' %>"><%= i %></a>
                </li>
            <% } %>

            <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                <a class="page-link" href="/threads?page=<%= currentPage + 1 %><%= currentTag ? '&tag=' + currentTag : '' %><%= currentKeyword ? '&keyword=' + currentKeyword : '' %>">次へ</a>
            </li>
        </ul>
    </nav>
<% } %>

<%- include('../partials/deleteModal') %>

<script>
    const deleteButtons = document.querySelectorAll('.delete-trigger');
    const deleteForm = document.getElementById('deleteForm');

    if (deleteForm) {
        deleteButtons.forEach(button => {
            button.addEventListener('click', () => {
                const id = button.dataset.id;
                const type = button.dataset.type;
                
                if (type === "thread") {
                deleteForm.action = `/threads/${id}?_method=DELETE`;
                } else {
                    deleteForm.action = `/posts/${id}?_method=DELETE`;
                }
            });
        });
    }

    const categoryBtns = document.querySelectorAll('.category-btn');

    categoryBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            const group = document.querySelector(`.tag-group[data-group="${btn.dataset.category}"]`);

            // 他のグループを閉じる
            document.querySelectorAll('.tag-group').forEach(g => {
                if (g !== group) {
                    g.classList.add('d-none');
                    document.querySelector(`.category-btn[data-category="${g.dataset.group}"]`)
                        .classList.replace('btn-primary', 'btn-outline-primary');
                }
            });

            // クリックしたグループを開閉
            group.classList.toggle('d-none');
            btn.classList.toggle('btn-outline-primary');
            btn.classList.toggle('btn-primary');
        });
    });
    
</script>