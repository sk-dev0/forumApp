<% layout('layouts/boilerplate') %>
<h1>スレッドの編集</h1>

<form action="/threads/<%= thread._id %>/?_method=PUT" method="POST" class="needs-validation" novalidate>
    <div class="mb-3">
        <label for="threadTitle" class="form-label">スレッドのタイトル</label>
        <input type="text" class="form-control" id="threadTitle" name="title" value="<%= thread.title %>" required>
        <div class="valid-feedback">
            OK!
        </div>
        <div class="invalid-feedback">
            タイトルを入力してください
        </div>
    </div>
    <div class="mb-3">
        <label for="threadContent" class="form-label">スレッドの内容</label>
        <textarea class="form-control" id="threadContent" name="content" rows="3" required><%= thread.content %></textarea>
        <div class="valid-feedback">
            OK!
        </div>
        <div class="invalid-feedback">
            内容を入力してください
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">タグ</label>
        
        <!-- 親カテゴリのボタン -->
        <div class="d-flex flex-wrap gap-2 mb-2">
            <% for (let category in tagCategories) { %>
                <button type="button" class="btn btn-outline-secondary btn-sm category-btn" data-category="<%= category %>">
                    <%= category %>
                </button>
            <% } %>
        </div>

        <!-- 子タグのチェックボックス（最初は非表示） -->
        <div id="tagCheckboxes" class="d-flex flex-wrap gap-2 p-2 border rounded" style="display:none!important">
            <% for (let category in tagCategories) { %>
                <div class="tag-group" data-group="<%= category %>" style="display:none">
                    <% for (let tag of tagCategories[category]) { %>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" name="tags" value="<%= tag %>" id="tag-<%= tag %>" <%= thread.tags && thread.tags.includes(tag) ? 'checked' : '' %>>
                            <label class="form-check-label" for="tag-<%= tag %>"><%= tag %></label>
                        </div>
                    <% } %>
                </div>
            <% } %>
        </div>
        <div id="tagError" class="text-danger small mt-1" style="display:none">
            タグを1つ以上選択してください
        </div>
    </div>
    
    <div class="d-flex justify-content-between mt-3">
        <a href="/threads" class="btn btn-danger">
            スレッド一覧に戻る
        </a>
        <button id="submitBtn" class="btn btn-primary px-4">
            更新
        </button>
    </div>
</form>

<script>
    const categoryBtns = document.querySelectorAll('.category-btn');
    const tagCheckboxes = document.getElementById('tagCheckboxes');

    const existingTags = <%- JSON.stringify(thread.tags || []) %>;
    const tagCategories = <%- JSON.stringify(tagCategories) %>;

    for (let category in tagCategories) {
        const hasTag = tagCategories[category].some(tag => existingTags.includes(tag));
        if (hasTag) {
            const group = document.querySelector(`.tag-group[data-group="${category}"]`);
            const btn = document.querySelector(`.category-btn[data-category="${category}"]`);
            group.style.display = 'flex';
            btn.classList.replace('btn-outline-secondary', 'btn-secondary');
        }
    }

    tagCheckboxes.style.display = [...document.querySelectorAll('.tag-group')]
        .some(g => g.style.display !== 'none') ? 'flex' : 'none';

    categoryBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            const category = btn.dataset.category;

            // ボタンのアクティブ状態を切り替え
            btn.classList.toggle('active');
            btn.classList.toggle('btn-outline-secondary');
            btn.classList.toggle('btn-secondary');

            // 対応する子タググループの表示切り替え
            const group = document.querySelector(`.tag-group[data-group="${category}"]`);
            group.style.display = group.style.display === 'none' ? 'flex' : 'none';

            // 非表示になったグループのチェックを外す
            if (group.style.display === 'none') {
                group.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
            }

            // 表示中のグループが1つ以上あればエリア全体を表示
            const anyVisible = [...document.querySelectorAll('.tag-group')]
                .some(g => g.style.display !== 'none');
            tagCheckboxes.style.display = anyVisible ? 'flex' : 'none';
        });
    });

    const form = document.querySelector('.needs-validation');

    form.addEventListener('submit', e => {
        const checkedTags = document.querySelectorAll('input[name="tags"]:checked');
        const tagError = document.getElementById('tagError');

        if (checkedTags.length === 0) {
            tagError.style.display = 'block';
            e.preventDefault();
            e.stopPropagation();
        } else {
            tagError.style.display = 'none';
        }
    });
</script>
